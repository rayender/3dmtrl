{
  "name": "3dMtrl",
  "short_name": "3dMtrl",
  "description": "3D modeling in your browser for rooms, furniture and interiors.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#1c222a",
  "theme_color": "#1c222a",
  "categories": [
    "design",
    "productivity",
    "graphics"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "model/gltf-binary": [
          ".glb"
        ],
        "model/obj": [
          ".obj"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}